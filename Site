      {id:"gr-hood-02",name:"Minimal Zip Hoodie",category:"Hoodies",price:3890,tag:"New arrival",description:"Layer-ready · Modern profile",image:"https://images.unsplash.com/photo-1578681994506-b8f463449011?auto=format&fit=crop&w=700&q=85",sizes:["S","M","L","XL"]},
      {id:"gr-shirt-02",name:"Textured Casual Shirt",category:"Shirts",price:2990,tag:"Versatile",description:"Smart casual · All-day wear",image:"https://images.unsplash.com/photo-1603252109303-2751441dd157?auto=format&fit=crop&w=700&q=85",sizes:["S","M","L","XL"]},
      {id:"gr-cap-01",name:"Royal Everyday Cap",category:"Accessories",price:990,tag:"Finishing touch",description:"Minimal detail · Adjustable",image:"https://images.unsplash.com/photo-1588850561407-ed78c282e89b?auto=format&fit=crop&w=700&q=85",sizes:["One Size"]},
      {id:"gr-tee-03",name:"Premium Boxy Tee",category:"T-Shirts",price:1990,tag:"Everyday",description:"Boxy silhouette · Easy fit",image:"https://images.unsplash.com/photo-1562157873-818bc0726f68?auto=format&fit=crop&w=700&q=85",sizes:["S","M","L","XL"]}
    ];

    const $ = (selector) => document.querySelector(selector);
    const money = (amount) => "Rs. " + Number(amount).toLocaleString("en-PK");
    let selectedCategory = "All";
    let cart = loadCart();
    let wishlist = new Set();
    let toastTimer;

    function loadCart(){
      try { const saved = JSON.parse(localStorage.getItem("gr_cart") || "[]"); return Array.isArray(saved) ? saved.filter(x => products.some(p => p.id === x.id) && Number.isInteger(x.qty) && x.qty > 0 && products.find(p=>p.id===x.id).sizes.includes(x.size)) : []; }
      catch { return []; }
    }
    function saveCart(){ try{localStorage.setItem("gr_cart",JSON.stringify(cart));}catch{} }
    function cartQty(){return cart.reduce((sum,item)=>sum+item.qty,0)}
    function cartTotal(){return cart.reduce((sum,item)=>sum+products.find(p=>p.id===item.id).price*item.qty,0)}
    function safeText(value){return String(value).replace(/[&<>"']/g, ch => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[ch]))}
    function showToast(message){const toast=$("#toast");toast.textContent=message;toast.classList.add("show");clearTimeout(toastTimer);toastTimer=setTimeout(()=>toast.classList.remove("show"),2600)}

    function renderProducts(){
      const query = ($("#searchInput")?.value || "").trim().toLowerCase();
      const shown = products.filter(p => (selectedCategory==="All" || p.category===selectedCategory) && (!query || `${p.name} ${p.category} ${p.description}`.toLowerCase().includes(query)));
      $("#productGrid").innerHTML = shown.length ? shown.map(p=>`
        <article class="product-card">
          <div class="product-image"><img src="${p.image}" alt="${safeText(p.name)}" loading="lazy" onerror="this.onerror=null;this.src='https://placehold.co/600x800/f5f3ee/111111?text=GULL+ROYAL'"><span class="product-badge">${safeText(p.tag)}</span>
            <button class="wish" data-wish="${p.id}" aria-label="Add ${safeText(p.name)} to wishlist">${wishlist.has(p.id)?"♥":"♡"}</button>
          </div>
          <div class="product-info"><div class="product-top"><h3>${safeText(p.name)}</h3><span class="price">${money(p.price)}</span></div><p>${safeText(p.description)}</p>
          <div style="display:flex;gap:8px;align-items:center;margin-bottom:10px"><label for="size-${p.id}" style="font-size:10px;text-transform:uppercase;letter-spacing:.08em">Size</label><select id="size-${p.id}" aria-label="Choose size for ${safeText(p.name)}" style="flex:1;padding:8px;border:1px solid var(--line);background:transparent;font-size:11px">${p.sizes.map(s=>`<option value="${s}">${s}</option>`).join("")}</select></div>
          <button class="add-btn" data-add="${p.id}">Add to bag +</button></div>
        </article>`).join("") : `<p style="grid-column:1/-1;padding:35px 0;color:var(--muted)">No products found. Try another search or category.</p>`;
    }
    function renderCart(){
      $("#cartCount").textContent=cartQty();$("#drawerCount").textContent=cartQty();$("#cartSubtotal").textContent=money(cartTotal());
      if(!cart.length){$("#cartItems").innerHTML='<div class="cart-empty"><div style="font-size:35px;margin-bottom:12px">♧</div>Your bag is waiting.<br><br><button class="btn" id="emptyShopBtn">Explore collection</button></div>';$("#checkoutBtn").disabled=true;$("#checkoutBtn").style.opacity=".45";}
      else{
        $("#checkoutBtn").disabled=false;$("#checkoutBtn").style.opacity="1";
        $("#cartItems").innerHTML=cart.map(item=>{const p=products.find(x=>x.id===item.id);return `<div class="cart-row"><img src="${p.image}" alt="${safeText(p.name)}" onerror="this.onerror=null;this.src='https://placehold.co/300x400/f5f3ee/111111?text=GR'"><div><h3>${safeText(p.name)}</h3><small>Size: ${safeText(item.size)}</small><div class="qty"><button data-qty="-1" data-id="${p.id}" data-size="${item.size}" aria-label="Decrease quantity">−</button><span>${item.qty}</span><button data-qty="1" data-id="${p.id}" data-size="${item.size}" aria-label="Increase quantity">+</button></div><button class="remove" data-remove="${p.id}" data-size="${item.size}">Remove</button></div><strong style="font-size:12px">${money(p.price*item.qty)}</strong></div>`}).join("");
      }
      renderCheckoutSummary();
    }
    function renderCheckoutSummary(){
      const target=$("#checkoutSummary");if(!target)return;
      target.innerHTML=`<strong style="font-size:11px;text-transform:uppercase;letter-spacing:.1em">Order summary</strong>${cart.map(item=>{const p=products.find(x=>x.id===item.id);return `<div class="summary-line"><span>${safeText(p.name)} · ${safeText(item.size)} × ${item.qty}</span><span>${money(p.price*item.qty)}</span></div>`}).join("")}<div class="summary-line total"><span>Total (COD)</span><span>${money(cartTotal())}</span></div>`;
    }
    function openCart(){ $("#overlay").classList.add("show");$("#cartDrawer").classList.add("show");$("#cartDrawer").setAttribute("aria-hidden","false");document.body.style.overflow="hidden"; }
    function closeCart(){ $("#overlay").classList.remove("show");$("#cartDrawer").classList.remove("show");$("#cartDrawer").setAttribute("aria-hidden","true");if(!$("#checkoutModal").classList.contains("show"))document.body.style.overflow=""; }
    function openCheckout(){
      if(!cart.length){showToast("Your bag is empty.");return;}
      closeCart();$("#checkoutMessage").textContent="";$("#checkoutMessage").className="form-message";$("#checkoutModal").classList.add("show");document.body.style.overflow="hidden";renderCheckoutSummary();setTimeout(()=>$("#customerName").focus(),80);
    }
    function closeCheckout(){ $("#checkoutModal").classList.remove("show");document.body.style.overflow=""; }
    function addToCart(id,size){
      const product=products.find(p=>p.id===id);if(!product||!product.sizes.includes(size))return;
      const existing=cart.find(item=>item.id===id&&item.size===size);
      if(existing)existing.qty=Math.min(existing.qty+1,20);else cart.push({id,size,qty:1});
      saveCart();renderCart();showToast(`${product.name} added to your bag.`);
    }

    $("#productGrid").addEventListener("click",e=>{
      const add=e.target.closest("[data-add]");if(add){const id=add.dataset.add;addToCart(id,$(`#size-${id}`).value);return;}
      const wish=e.target.closest("[data-wish]");if(wish){const id=wish.dataset.wish;if(wishlist.has(id))wishlist.delete(id);else wishlist.add(id);renderProducts();showToast(wishlist.has(id)?"Added to wishlist.":"Removed from wishlist.");}
    });
    $("#filters").addEventListener("click",e=>{const btn=e.target.closest("[data-category]");if(!btn)return;selectedCategory=btn.dataset.category;document.querySelectorAll(".filter").forEach(b=>b.classList.toggle("active",b===btn));renderProducts();});
    $("#cartItems").addEventListener("click",e=>{
      if(e.target.closest("#emptyShopBtn")){closeCart();$("#shop").scrollIntoView({behavior:"smooth"});return;}
      const qty=e.target.closest("[data-qty]");if(qty){const item=cart.find(x=>x.id===qty.dataset.id&&x.size===qty.dataset.size);if(item){item.qty+=Number(qty.dataset.qty);if(item.qty<=0)cart=cart.filter(x=>x!==item);if(item.qty>20)item.qty=20;saveCart();renderCart();}return;}
      const remove=e.target.closest("[data-remove]");if(remove){cart=cart.filter(x=>!(x.id===remove.dataset.remove&&x.size===remove.dataset.size));saveCart();renderCart();}
    });
    $("#cartBtn").addEventListener("click",openCart);$("#closeCart").addEventListener("click",closeCart);$("#overlay").addEventListener("click",closeCart);$("#checkoutBtn").addEventListener("click",openCheckout);$("#closeCheckout").addEventListener("click",closeCheckout);
    $("#checkoutModal").addEventListener("click",e=>{if(e.target===$("#checkoutModal"))closeCheckout();});
    $("#searchBtn").addEventListener("click",()=>{const panel=$("#searchPanel");panel.style.display=panel.style.display==="block"?"none":"block";if(panel.style.display==="block")$("#searchInput").focus();});
    $("#searchInput").addEventListener("input",renderProducts);
    $("#menuToggle").addEventListener("click",()=>$("#navLinks").classList.toggle("open"));
    $("#navLinks").addEventListener("click",e=>{if(e.target.closest("a"))$("#navLinks").classList.remove("open");});
    $("#continueShopping").addEventListener("click",()=>{$("#confirmationModal").classList.remove("show");document.body.style.overflow="";$("#shop").scrollIntoView({behavior:"smooth"});});
    $("#newsletterForm").addEventListener("submit",e=>{e.preventDefault();$("#newsletterMessage").textContent="Thanks for your interest! Newsletter signup is a demo until an email marketing service is connected.";$("#newsletterEmail").value="";});

    function getOrderText(order){
      const items=order.items.map(item=>`${item.name} | Size: ${item.size} | Qty: ${item.qty} | ${money(item.price*item.qty)}`).join("\n");
      return `NEW GULL ROYAL COD ORDER\nOrder reference: ${order.orderId}\n\nCUSTOMER\nName: ${order.customer.name}\nPhone: ${order.customer.phone}\nEmail: ${order.customer.email||"Not provided"}\nAddress: ${order.customer.address}\nCity: ${order.customer.city}\nNotes: ${order.customer.note||"None"}\n\nITEMS\n${items}\n\nTOTAL: ${money(order.total)}\nPayment: Cash on Delivery\nStatus: Pending store confirmation`;
    }
    function sendOrderEmail(order){
      return new Promise((resolve,reject)=>{
        const configured=EMAILJS_PUBLIC_KEY!=="YOUR_EMAILJS_PUBLIC_KEY"&&EMAILJS_SERVICE_ID!=="YOUR_EMAILJS_SERVICE_ID"&&EMAILJS_TEMPLATE_ID!=="YOUR_EMAILJS_TEMPLATE_ID";
        if(!configured){reject(new Error("Email service is not configured yet. Add your EmailJS public key, service ID and template ID in index.html before accepting real orders."));return;}
        if(!window.emailjs){reject(new Error("Email service library did not load. Please check your connection and try again."));return;}
        const itemsText=order.items.map(item=>`${item.name} | Size: ${item.size} | Qty: ${item.qty} | ${money(item.price*item.qty)}`).join("\n");
        const templateParams={
          to_email:STORE_EMAIL,order_id:order.orderId,customer_name:order.customer.name,customer_phone:order.customer.phone,
          customer_email:order.customer.email||"Not provided",delivery_address:order.customer.address,customer_city:order.customer.city,
          order_notes:order.customer.note||"None",order_items:itemsText,order_total:money(order.total),payment_method:"Cash on Delivery",
          order_details:getOrderText(order),reply_to:order.customer.email||""
        };
        window.emailjs.send(EMAILJS_SERVICE_ID,EMAILJS_TEMPLATE_ID,templateParams).then(resolve).catch(reject);
      });
    }
    $("#checkoutForm").addEventListener("submit",async e=>{
      e.preventDefault();
      if(!cart.length){$("#checkoutMessage").textContent="Your bag is empty.";$("#checkoutMessage").className="form-message error";return;}
      const form=e.currentTarget;if(!form.reportValidity())return;
      const btn=$("#placeOrderBtn");const msg=$("#checkoutMessage");btn.disabled=true;btn.textContent="Submitting order…";msg.className="form-message";msg.textContent="Sending your order details securely to the store. Please wait.";
      const order={
        orderId:"GR-"+Date.now().toString(36).toUpperCase(),
        customer:{name:$("#customerName").value.trim(),phone:$("#customerPhone").value.trim(),email:$("#customerEmail").value.trim(),address:$("#customerAddress").value.trim(),city:$("#customerCity").value.trim(),note:$("#customerSizeNote").value.trim()},
        items:cart.map(item=>{const p=products.find(x=>x.id===item.id);return {id:p.id,name:p.name,price:p.price,size:item.size,qty:item.qty};}),
        total:cartTotal()
      };
      try{
        await sendOrderEmail(order);
        cart=[];saveCart();renderCart();closeCheckout();$("#confirmationText").textContent=`Your order reference is ${order.orderId}. Your order details have been sent to the store. Payment is Cash on Delivery. The store may contact you to confirm delivery details.`;$("#confirmationModal").classList.add("show");document.body.style.overflow="hidden";form.reset();
      }catch(err){
        console.error("Order email failed:",err);
        msg.className="form-message error";
        msg.textContent=(err&&err.message&&err.message.includes("not configured"))?`Email is not connected yet. Your order has NOT been submitted. Configure EmailJS to receive orders at ${STORE_EMAIL}. Your cart is still saved.`:`We couldn't send this order, so it has NOT been confirmed. Please try again in a moment. If this continues, contact the store directly.`;
      }finally{btn.disabled=false;btn.textContent="Place COD order →";}
    });

    // Load EmailJS only when a valid public key is configured.
    if(EMAILJS_PUBLIC_KEY!=="YOUR_EMAILJS_PUBLIC_KEY"){
      const script=document.createElement("script");script.src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js";script.onload=()=>window.emailjs&&window.emailjs.init({publicKey:EMAILJS_PUBLIC_KEY});script.onerror=()=>console.warn("EmailJS library could not load.");document.head.appendChild(script);
    }
    $("#year").textContent=new Date().getFullYear();
    renderProducts();renderCart();
  </script>
</body>
</html>
